# Copy to services/backend/.env (never commit .env)
TRUSTBANK_ENVIRONMENT=local
TRUSTBANK_GOOGLE_CLOUD_PROJECT=trustbank-local

# Required. Token secret: at least 32 chars (e.g. openssl rand -hex 32). Never commit real values.
TRUSTBANK_TOKEN_SECRET=
TRUSTBANK_INVESTIGATOR_CODE=
TRUSTBANK_CORS_ORIGINS=["http://localhost:4200"]

# Firestore: emulator for local work. Leave empty to use real Firestore (ADC credentials).
TRUSTBANK_FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# Neo4j: local Docker, or an IAP tunnel to the VM (see infra/README.md)
TRUSTBANK_NEO4J_URI=bolt://localhost:7687
TRUSTBANK_NEO4J_USER=neo4j
TRUSTBANK_NEO4J_PASSWORD=trustbank-local-pw
