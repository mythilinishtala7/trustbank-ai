{
  "hosting": {
    "site": "trustbank-pausepay",
    "public": "apps/banking-web/dist/banking-web/browser",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": { "serviceId": "trustbank-api", "region": "us-central1" }
      },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
